{
  "_comment": "Maps changed-file globs to documentation sections under docs/. Used by /release-docs.",
  "docs_root": "docs/",
  "sections": {
    "rest-api": [
      "Models/REST_API/**/*.php"
    ],
    "bogo-deals": [
      "Models/BOGO/**/*.php",
      "Models/BOGO_Deals.php"
    ],
    "cart-conditions": [
      "Models/Cart_Conditions.php",
      "Models/Cart_Conditions/**/*.php"
    ],
    "features": [
      "Models/Checkout.php",
      "Models/Coupon_Templates.php",
      "Models/Edit_Coupon.php",
      "Models/Editor_Blocks.php",
      "Models/Emails.php",
      "Models/Feature_Custom_Taxonomy.php",
      "Models/General.php",
      "Models/Notifications.php",
      "Models/Order_Details.php",
      "Models/Role_Restrictions.php",
      "Models/Scheduler.php",
      "Models/Send_Coupon.php",
      "Models/Store_Credits/**/*.php",
      "Models/URL_Coupons.php",
      "Models/Usage.php",
      "Models/WC_Blocks.php",
      "Models/Objects/**/*.php",
      "Models/Third_Party_Integrations/**/*.php",
      "Models/Tools/**/*.php",
      "Abstracts/**/*.php",
      "Helpers/**/*.php",
      "Traits/**/*.php",
      "packages/acfwf-blocks/**/*.{ts,tsx,js,jsx}",
      "packages/acfwf-cart/**/*.{ts,tsx,js,jsx}",
      "packages/acfwf-cart-block/**/*.{ts,tsx,js,jsx}",
      "packages/acfwf-checkout/**/*.{ts,tsx,js,jsx}",
      "packages/acfwf-checkout-block/**/*.{ts,tsx,js,jsx}",
      "packages/acfwf-edit-advanced-coupon/**/*.{ts,tsx,js,jsx}",
      "packages/acfwf-edit-order/**/*.{ts,tsx,js,jsx}",
      "packages/acfwf-store-credits-frontend/**/*.{ts,tsx,js,jsx}"
    ]
  },
  "ignore": [
    "tests/**",
    "dist/**",
    "node_modules/**",
    "languages/**",
    "data/**",
    "images/**",
    "views/**",
    "templates/**",
    "css/**",
    "js/**",
    "**/*.scss",
    "**/*.css",
    "Models/Admin_App.php",
    "Models/Bootstrap.php",
    "Models/Script_Loader.php",
    "Models/Getting_Started.php",
    "Models/Help_Links.php",
    "Models/Network_Admin.php",
    "Models/Notices.php",
    "Models/Notices/**",
    "Models/Upsell.php",
    "Models/WC_Admin_Notes.php",
    "Models/Objects/Vite_App.php",
    "**/index.php",
    "packages/acfwf-admin/**",
    "packages/acfwf-admin-app/**",
    "packages/acfwf-notices/**",
    "packages/acfwf-wc-admin/**",
    "packages/shared/**",
    "packages/hmr.txt",
    "advanced-coupons-for-woocommerce-free.php",
    "uninstall.php",
    "index.php",
    "vite.config.ts",
    "readme.txt",
    "*.md",
    "*.lock",
    "*.json",
    "package.json",
    "pnpm-lock.yaml",
    "composer.lock",
    "phpcs.xml",
    ".gitattributes",
    ".github/**"
  ],
  "branch_template": "docs/release-{tag}",
  "commit_message_template": "Docs: Update documentation for {tag}\n\nRegenerated docs for sections affected by changes since {prev_tag}:\n{sections}"
}
